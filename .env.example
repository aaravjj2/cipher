# Cipher active app credentials.
# Copy this file to cipher-system/app/.env and fill the values locally.
# The browser never sees these secrets; the Python core reads them server-side.

# Preferred for real-time OPRA options data.
ALPACA_ALGO_PLUS_KEY=
ALPACA_ALGO_PLUS_SECRET=

# Optional aliases supported by cipher-system/core/app.py.
# ALPACA_ALGO_KEY=
# ALPACA_ALGO_SECRET=
# ALPACA_API_KEY=
# ALPACA_API_SECRET=

# Options feed:
# - opra: real-time OPRA if the account/subscription allows it.
# - indicative: delayed/modified feed for UI/debug fallback only.
ALPACA_DATA_FEED=opra

# Stock feed:
# - sip: all-US-exchange stock data if available.
# - iex: fallback for accounts without SIP access.
ALPACA_STOCK_FEED=sip

# Local ports. These are optional; defaults are core 8282 and web 8283.
# CIPHER_CORE_PORT=8282
# PORT=8283
