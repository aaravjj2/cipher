[Unit]
Description=Cipher Tradier read-only underlying and option stream collector
Requires=cipher-secrets.service
After=network-online.target cipher-secrets.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=aarav
Group=aarav
WorkingDirectory=/home/aarav/Aarav/cipher/cipher-system
EnvironmentFile=-/etc/cipher/cipher.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/lib/cipher/run-tradier-loop.sh
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/aarav/Aarav/cipher/cipher-system/data
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cipher-tradier

[Install]
WantedBy=multi-user.target
