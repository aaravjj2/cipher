[Unit]
Description=Cipher prospective TSLA and weekly-radar shadow fronttests
Wants=network-online.target
After=network-online.target cipher-core.service cipher-gex.service

[Service]
Type=oneshot
User=aarav
Group=aarav
WorkingDirectory=/home/aarav/Aarav/cipher/cipher-system
EnvironmentFile=-/etc/cipher/cipher.env
ExecStart=/home/aarav/.venvs/cipher/bin/python scripts/run_prospective_fronttests.py
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/aarav/Aarav/cipher/runtime/data/prospective_fronttests
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cipher-prospective-fronttests

[Install]
WantedBy=multi-user.target
