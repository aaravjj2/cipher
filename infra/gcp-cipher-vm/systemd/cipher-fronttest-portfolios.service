[Unit]
Description=Cipher six-strategy option shadow fronttest pass
Wants=network-online.target
After=network-online.target cipher-core.service

[Service]
Type=oneshot
User=aarav
Group=aarav
WorkingDirectory=/home/aarav/Aarav/cipher/cipher-system
EnvironmentFile=-/etc/cipher/cipher.env
ExecStart=/home/aarav/.venvs/cipher/bin/python scripts/run_fronttest_portfolios.py
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/aarav/Aarav/cipher/runtime/data/fronttest_portfolios
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cipher-fronttest-portfolios

[Install]
WantedBy=multi-user.target
