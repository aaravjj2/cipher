[Unit]
Description=Send daily Cipher shadow portfolio changes to Discord
After=cipher-fronttest-portfolios.service

[Service]
Type=oneshot
User=aarav
Group=aarav
WorkingDirectory=/home/aarav/Aarav/cipher/cipher-system
EnvironmentFile=-/etc/cipher/cipher.env
ExecStart=/home/aarav/.venvs/cipher/bin/python scripts/send_portfolio_daily_discord.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/aarav/Aarav/cipher/runtime/data/fronttest_portfolios
ReadWritePaths=/home/aarav/Aarav/cipher/runtime/data/prospective_fronttests
# SQLite WAL readers may need to initialize shared-memory sidecars. Keep these
# exceptions restricted to the specific ledger directories, not runtime root.
ReadWritePaths=/home/aarav/Aarav/cipher/runtime/data/paper_runtime/data/paper_trades
ReadWritePaths=/home/aarav/Aarav/cipher/runtime/data/paper_runtime/cohorts/confirmation
ReadWritePaths=/home/aarav/Aarav/cipher/runtime/data/paper_runtime/cohorts/cost
ReadWritePaths=/home/aarav/Aarav/cipher/runtime/data/paper_runtime/cohorts/exit
ReadWritePaths=/home/aarav/Aarav/cipher/runtime/data/telegram
ReadWritePaths=/home/aarav/Aarav/cipher/earnings_model/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cipher-portfolio-discord-daily
