[Unit]
Description=Cipher local multi-strategy shadow paper executor
Wants=network-online.target cipher-tradier.service
After=network-online.target cipher-tradier.service

[Service]
Type=simple
User=aarav
Group=aarav
WorkingDirectory=/home/aarav/Aarav/cipher/cipher-system
EnvironmentFile=-/etc/cipher/cipher.env
Environment=CIPHER_PAPER_RUNTIME=/home/aarav/Aarav/cipher/runtime/data/paper_runtime
ExecStart=/home/aarav/.venvs/cipher/bin/python -m core.paper_executor.service /home/aarav/Aarav/cipher/cipher-system/config/paper_executor_shadow.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/aarav/Aarav/cipher/runtime/data/paper_runtime
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cipher-paper-executor

[Install]
WantedBy=multi-user.target
