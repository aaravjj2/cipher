[Unit]
Description=Cipher GEX history capture loop
Requires=cipher-secrets.service
After=network-online.target cipher-secrets.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=aarav
Group=aarav
WorkingDirectory=/home/aarav/Aarav/cipher/cipher-system
EnvironmentFile=-/etc/cipher/cipher.env
ExecStart=/usr/local/lib/cipher/run-gex-loop.sh
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cipher-gex

[Install]
WantedBy=multi-user.target
