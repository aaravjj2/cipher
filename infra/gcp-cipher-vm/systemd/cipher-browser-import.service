[Unit]
Description=Import mirrored Cipher browser batches into scanner-ingest v2
Requires=cipher-web.service
After=network-online.target cipher-web.service cipher-browser-folder-sync.service
Wants=network-online.target

[Service]
Type=oneshot
User=aarav
Group=aarav
WorkingDirectory=/home/aarav/Aarav/cipher
ExecStart=/home/aarav/.venvs/cipher/bin/python /home/aarav/Aarav/cipher/cipher-system/scripts/import_browser_gcs_payloads.py --market-hours-only --market-start 09:25 --market-end 16:25
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# browser_ingest receives the corpus; the governance hooks also register every
# accepted batch into the research_registry ledger under data/governance.
ReadWritePaths=/home/aarav/Aarav/cipher/cipher-system/data/browser_ingest /home/aarav/Aarav/cipher/cipher-system/data/governance
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cipher-browser-import
