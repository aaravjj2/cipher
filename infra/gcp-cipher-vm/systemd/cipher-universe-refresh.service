[Unit]
Description=Validate Cipher scanner universe against active Alpaca options assets
After=network-online.target cipher-secrets.service

[Service]
Type=oneshot
User=aarav
Group=aarav
WorkingDirectory=/home/aarav/Aarav/cipher/cipher-github/cipher-system
EnvironmentFile=/etc/cipher/cipher.env
ExecStart=/usr/bin/env CIPHER_HOSTED=0 /home/aarav/.venvs/cipher/bin/python scripts/refresh_optionable_universe.py
# Scanner loads its universe at startup; weekly off-hours restart publishes it.
ExecStartPost=+/usr/bin/systemctl try-restart cipher-core.service
TimeoutStartSec=120
NoNewPrivileges=yes
PrivateTmp=yes
