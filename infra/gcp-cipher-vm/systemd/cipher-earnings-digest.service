[Unit]
Description=Refresh Cipher earnings radar and deliver the daily Discord digest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aarav
Group=aarav
WorkingDirectory=/home/aarav/Aarav/cipher/cipher-github
# DISCORD_PROGRESS_WEBHOOK lives in the server env file. The research venv is
# used because earnings_model requires joblib, which the main cipher venv lacks.
EnvironmentFile=-/etc/cipher/cipher.env
# Run every stage even if one fails, but preserve a failing service result so
# monitoring cannot report a partial digest as healthy.
ExecStart=/bin/bash -c 'status=0; /home/aarav/Aarav/cipher/cipher-github/.venv-research-py312/bin/python -m earnings_model paper-settle || status=1; /home/aarav/Aarav/cipher/cipher-github/.venv-research-py312/bin/python -m earnings_model radar --json-output /home/aarav/Aarav/cipher/runtime/data/earnings_radar.json || status=1; /home/aarav/Aarav/cipher/cipher-github/.venv-research-py312/bin/python -m earnings_model paper-enter || status=1; /home/aarav/Aarav/cipher/cipher-github/.venv-research-py312/bin/python -m earnings_model notify-discord --type all || status=1; exit $status'
NoNewPrivileges=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cipher-earnings-digest
