[Unit]
Description=Materialize Cipher secrets from Google Secret Manager
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
Environment=GOOGLE_CLOUD_PROJECT=project-eec91607-77a2-4be6-837
ExecStart=/home/aarav/.venvs/cipher/bin/python /usr/local/lib/cipher/sync-secrets.py
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
