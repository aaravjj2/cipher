# Local environments and credentials
.venv/
.venv-research-py312/
.env
.env.*
!.env.example
*.pem
*.key

# Rebuildable caches and test output
__pycache__/
*.py[cod]
.pytest_cache/
htmlcov/
.coverage*
*Zone.Identifier*

# The local raw lake and generated evidence are retained on disk but are too
# large and sensitive for the source-control baseline.
cipher-system/data
cipher-system/data/**
!cipher-system/data/.gitkeep
cipher-system/logs
cipher-system/app/.scanner-ingest-token
cipher-system/app/node_modules/
*.log

# Local runtime state, locks, databases, and temporary exports
*.sqlite
*.sqlite-*
*.db
*.db-*
*.tmp
*.temp
*.swp

# Research modules keep bulk raw data and large outputs on disk, not in git.
# (Plain path form also covers the local machine-specific data symlink.)
earnings_model/data
earnings_model/data/
"EOD strategy/data/"
"EOD strategy/results/"
cipher-system/.scanner-ingest-token
cipher-system/exports/**
cipher-system/access-obsidian-complete-audit/access-obsidian-audit/scanner-extra-screenshots/XX*

# Frontend (cipher-system/web) — source is tracked, build output is not.
cipher-system/web/node_modules/
cipher-system/web/.next/
cipher-system/web/out/
cipher-system/web/tsconfig.tsbuildinfo
# Published build + rolling backups produced by cipher-system/web/deploy.sh.
cipher-system/app/public/
cipher-system/app/public_new/
cipher-system/app/public_backup_*/
cipher-system/app/public.legacy/
cipher-system/app/.releases/

# Backtest bar cache — 68 MB of re-fetchable Alpaca OHLCV
cipher-system/data/bar_cache/

# Local release-capture retries; only named/sanitized walkthrough media is kept.
cipher-system/release-artifacts/page@*.webm

# Local runtime/release state
runtime/
