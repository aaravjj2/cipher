# Public browser variables only. These are safe to expose in the Vercel client bundle.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_CIPHER_API_ORIGIN=https://api.example.com

# Do not add any of these to Vercel browser variables:
# SUPABASE_SERVICE_ROLE_KEY
# ALPACA_API_KEY / ALPACA_API_SECRET
# ALPACA_ALGO_KEY / ALPACA_ALGO_SECRET
# CIPHER_INTERNAL_PROXY_TOKEN
