# Copy to .env and fill locally. Never commit the filled .env.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_ALGO_KEY=
ALPACA_ALGO_SECRET=
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
# Optional account pin: startup fails if the reconciled paper account differs.
CIPHER_ALPACA_PAPER_ACCOUNT_ID=
ALPACA_API_SECRET=
TRADIER_PRODUCTION_TOKEN=
TRADIER_ACCESS_TOKEN=
TRADIER_TOKEN=
TRADIER_SANDBOX_TOKEN=
TRADIER_SANDBOX_ACCOUNT=
LSE_API_KEY=
OPENCODE_ZEN_API_KEY=
# Single-user application fallback gate. Store only a scrypt hash, never plaintext.
CIPHER_APP_PASSWORD_HASH=
# Deployment-only Cloudflare Tunnel credential. Secret Manager materializes a token file.
CLOUDFLARE_TUNNEL_TOKEN=
# Ask Cipher (core/ask_cipher.py) — required for the chat panel to work at all.
ANTHROPIC_API_KEY=
# Hosted access profiles (server-only; never expose through NEXT_PUBLIC_*).
# Developer mode should normally be assigned in Supabase account_access (migration 0004).
# These comma-separated allowlists are an operator fallback during migration rollout.
CIPHER_DEVELOPER_USER_IDS=
CIPHER_DEVELOPER_EMAILS=
CIPHER_GUEST_MODE=0
CIPHER_GUEST_SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA,TSLA,AMD,MU
CIPHER_GUEST_SESSION_ABSOLUTE_MS=7200000
