{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cipher.local/schemas/research/feature-spec.schema.json",
  "title": "Cipher Feature Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature_id",
    "name",
    "version",
    "inputs",
    "lookback",
    "availability_lag_seconds",
    "missing_value_policy",
    "allowed_use",
    "implementation_hash",
    "leakage_checks"
  ],
  "properties": {
    "feature_id": {"type": "string", "pattern": "^feature_[a-f0-9]{12,64}$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "lookback": {"type": "string", "minLength": 1},
    "availability_lag_seconds": {"type": "integer", "minimum": 0},
    "missing_value_policy": {"type": "string", "minLength": 1},
    "allowed_use": {"enum": ["context", "filter", "ranking", "sizing", "execution"]},
    "implementation_hash": {"type": "string", "minLength": 12},
    "training_cutoff": {"type": ["string", "null"], "format": "date-time"},
    "model_artifact_id": {"type": ["string", "null"]},
    "leakage_checks": {"type": "object"},
    "description": {"type": "string"}
  }
}
